# Copy this file to backend\.env and fill in the keys you have. Everything is optional:
# each platform or feature switches on when its key is present. Never commit backend\.env.
# Step-by-step instructions for each key: SETUP.md

# ---- YouTube (free: 10,000 units/day) ----
YOUTUBE_API_KEY=
# Our own daily cap, below YouTube's 10,000 limit
YOUTUBE_DAILY_BUDGET=9000

# ---- Instagram + Facebook (Meta Graph API) ----
# Long-lived user token or system-user token of your Meta app
META_ACCESS_TOKEN=
# YOUR Instagram professional (Business/Creator) account ID. Competitors are read through it.
META_IG_USER_ID=
META_GRAPH_VERSION=v25.0
# Our own cap on Graph API calls per hour
META_HOURLY_BUDGET=180

# ---- Internet trends (no key needed) ----
# Google's daily "Trending now" searches for the workspace's country
TRENDS_GOOGLE_TRENDS=1
# Google News search per workspace topic. Google's RSS terms allow personal, non-commercial use:
# set to 0 for a commercial deployment.
TRENDS_GOOGLE_NEWS=1

# ---- Optional AI briefing (Claude) ----
# Adds an AI-written summary and content ideas on the Dashboard. Leave empty to use the
# rule-based briefing only (always available).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Optional MediaOps hand-off ----
MEDIAOPS_DRAFTS_URL=
MEDIAOPS_API_TOKEN=
