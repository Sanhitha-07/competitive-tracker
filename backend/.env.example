# Copy this file to backend\.env and fill in what you use. backend\.env is git-ignored: never commit it.
# Every value is optional: the API starts without any of them, and each missing integration is shown
# as "Not configured" in Accounts. Restart the API (run_api.bat) after changing this file.
# Full setup steps: SOCIAL_SETUP.md in the project folder.

# ---- YouTube (existing) ----
YOUTUBE_API_KEY=
YOUTUBE_DAILY_BUDGET=9000

# ---- MediaOps draft handoff (existing; empty = copy/paste) ----
MEDIAOPS_DRAFTS_URL=
MEDIAOPS_API_TOKEN=

# ---- Needed for Instagram, Facebook and X ----
# Encrypts stored access tokens. Generate once with:
#   backend\env\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you change it later, connected accounts must be reconnected.
TOKEN_ENCRYPTION_KEY=
# The address the platforms send users back to (this API) and where the app opens afterwards.
# Change these when the tracker runs on a real domain (the redirect URIs must use https there).
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ---- Instagram and Facebook (one Meta developer app for both) ----
# developers.facebook.com > My Apps > your app > App settings > Basic
META_APP_ID=
META_APP_SECRET=
# Optional: Graph API version (default v26.0)
META_GRAPH_VERSION=
# Redirect URIs to add in the app's Facebook Login settings:
#   http://localhost:8000/oauth/facebook/callback
#   http://localhost:8000/oauth/instagram/callback

# ---- X ----
# developer.x.com > your project > your app > Keys and tokens > OAuth 2.0 Client ID and Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
# Callback URL to add in the app's User authentication settings:
#   http://localhost:8000/oauth/x/callback
# Optional: posts read per account per refresh (5-100, default 20). Each read is billed by X.
X_MAX_POSTS_PER_ACCOUNT=20

# ---- Internet trends (no key needed) ----
# Google's daily "Trending now" searches for the workspace's country
TRENDS_GOOGLE_TRENDS=1
# Google News search per workspace topic. Google's RSS terms allow personal, non-commercial use:
# set to 0 for a commercial deployment.
TRENDS_GOOGLE_NEWS=1

# ---- Optional AI briefing (Claude) ----
# Adds an AI-written summary and content ideas on the Overview tab. Leave empty to use the
# rule-based briefing only (always available).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
